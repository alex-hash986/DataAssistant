APP_NAME="Data Assistant"
# Address for a direct Uvicorn launch. Dockerfile sets its own bind address.
APP_HOST=127.0.0.1
# Direct Uvicorn port or Compose host port.
APP_PORT=8000
MAX_FILE_SIZE=10MB
UPLOAD_DIR=storage/uploads
OUTPUT_DIR=storage/outputs
LOG_LEVEL=INFO
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_HISTORY_MESSAGES=8
# Optional SDK endpoint override. Leave commented to use the default.
# OPENAI_BASE_URL=https://provider.example/v1
